# Lightweight ARM64 Dockerfile for AegisEdgeAI
# Uses system packages when available, avoiding lengthy compilation

FROM ubuntu:22.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including TPM stack
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    git \
    swtpm \
    tpm2-tools \
    libtss2-dev \
    libssl-dev \
    netcat-openbsd \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Set ARM64 environment variables for TPM
ENV PREFIX="/usr"
ENV TPM2TOOLS_TCTI="swtpm:host=127.0.0.1,port=2321"
ENV PYTHONPATH="/app"
ENV FLASK_ENV="production"

# Create application user
RUN useradd -m -s /bin/bash aegis && \
    mkdir -p /app /var/lib/swtpm-localca && \
    chown -R aegis:aegis /app /var/lib/swtpm-localca

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=aegis:aegis . .

# Create Python virtual environment and install dependencies
RUN python3 -m venv .venv && \
    .venv/bin/pip install --upgrade pip && \
    .venv/bin/pip install -r zero-trust/requirements.txt

# Make scripts executable
RUN chmod +x zero-trust/system-setup.sh \
    zero-trust/system-setup-arm64.sh \
    zero-trust/tpm/swtpm.sh \
    zero-trust/tpm/tpm-ek-ak-persist.sh \
    zero-trust/initall.sh \
    test-arm64-implementation.sh \
    deploy-arm64.sh

# Build ARM64-specific binaries using system libraries
WORKDIR /app/zero-trust/tpm
RUN make clean && make

# Switch to application user
USER aegis
WORKDIR /app

# Create TPM state directory
RUN mkdir -p ~/.swtpm/ztpm

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose ports
EXPOSE 5000 5001 5002 2321 2322

# Create startup script that uses virtual environment
RUN echo '#!/bin/bash' > start-simple.sh && \
    echo 'set -e' >> start-simple.sh && \
    echo 'source .venv/bin/activate' >> start-simple.sh && \
    echo 'echo "=== Starting AegisEdgeAI on ARM64 ==="' >> start-simple.sh && \
    echo 'echo "Architecture: $(uname -m)"' >> start-simple.sh && \
    echo 'echo "TPM Tools: $(swtpm --version | head -1)"' >> start-simple.sh && \
    echo 'echo "Python: $(python --version)"' >> start-simple.sh && \
    echo '' >> start-simple.sh && \
    echo '# Start software TPM in background' >> start-simple.sh && \
    echo 'echo "Starting software TPM..."' >> start-simple.sh && \
    echo 'cd zero-trust/tpm' >> start-simple.sh && \
    echo './swtpm.sh &' >> start-simple.sh && \
    echo 'sleep 5' >> start-simple.sh && \
    echo '' >> start-simple.sh && \
    echo '# Initialize TPM keys' >> start-simple.sh && \
    echo 'echo "Initializing TPM keys..."' >> start-simple.sh && \
    echo './tpm-ek-ak-persist.sh' >> start-simple.sh && \
    echo 'cd ../..' >> start-simple.sh && \
    echo '' >> start-simple.sh && \
    echo '# Start services' >> start-simple.sh && \
    echo 'echo "Starting AegisEdgeAI services..."' >> start-simple.sh && \
    echo 'cd zero-trust' >> start-simple.sh && \
    echo 'python agent/app.py &' >> start-simple.sh && \
    echo 'python collector/app.py &' >> start-simple.sh && \
    echo 'python gateway/app.py &' >> start-simple.sh && \
    echo '' >> start-simple.sh && \
    echo '# Keep container running' >> start-simple.sh && \
    echo 'echo "All services started. Keeping container alive..."' >> start-simple.sh && \
    echo 'tail -f /dev/null' >> start-simple.sh && \
    chmod +x start-simple.sh

# Default command
CMD ["./start-simple.sh"]